# ---------------------------------------------------------------------------
# GenTube — environment variables
# Copy to .env (not .env.local) and fill in. `pnpm db:setup` generates a local
# one with a Docker Postgres and fresh secrets.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------

# Postgres connection string. Local Docker default below; on Vercel use a
# Postgres from https://vercel.com/marketplace?category=databases
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Les tests tronquent chaque table entre chaque test : ils refusent de
# tourner ailleurs qu'en local. À poser quand DATABASE_URL désigne une base
# distante (Supabase), pour que la suite reste sur le Docker local.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Public origin of the app, used to build absolute URLs (OAuth callbacks,
# webhook targets). No trailing slash.
BASE_URL=http://localhost:3000

# Signing key for the session JWT (cookie `session`).
#   openssl rand -hex 32
AUTH_SECRET=

# AES-256-GCM key protecting secrets at rest — today the YouTube OAuth tokens
# in `youtube_tokens`. 32 bytes, hex or base64. Rotating it makes every stored
# token undecryptable, so tenants must reconnect their channel.
#   openssl rand -hex 32
ENCRYPTION_KEY=

# --- Cloudflare R2 (asset storage) ------------------------------------------
# Every object key MUST be prefixed with `<tenant_id>/`. Assets are served
# through short-lived signed URLs — the bucket stays private.
#
# NOT WIRED UP YET. lib/storage/index.ts freezes the contract (AssetStore,
# assetKey) and throws StorageNotConfiguredError until an R2 implementation
# lands. Voice-over, image generation, video generation and the final render
# all wait on it — it is the first blocking dependency of the pipeline.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gentube
# Préfixe racine, uniquement si le bucket est partagé avec un autre projet.
# Laisser vide quand le bucket est dédié à GenTube.
R2_PREFIX=
# Optionnel : déduit de R2_ACCOUNT_ID s'il est vide
# (https://<account_id>.r2.cloudflarestorage.com). À renseigner seulement pour
# un bucket derrière un domaine personnalisé.
R2_ENDPOINT=
# Pas de R2_PUBLIC_URL : le bucket ne doit jamais etre public. Tout se lit par
# une URL signee a duree de vie courte (AssetStore.signedUrl). Un bucket ouvert
# annulerait l'isolation multi-tenant : deviner 7/voice/42/1.mp3 suffirait a
# ecouter la narration d'un client.

# --- DeepSeek (script + storyboard generation) -------------------------------
# OpenAI-compatible API: POST /chat/completions, bearer auth, JSON mode.
# Two things were confirmed against the live account rather than assumed:
#   - the model ids are `deepseek-v4-flash` and `deepseek-v4-pro`. There is no
#     `deepseek-chat` on this account.
#   - they are REASONING models: the answer is preceded by internal reasoning
#     billed as completion tokens. A tight token budget is spent entirely on
#     reasoning and comes back HTTP 200, finish_reason "length", content EMPTY.
#     Hence the wide default below — raise it before blaming the model.

DEEPSEEK_API_KEY=
# Default: deepseek-v4-flash. The `pro` variant reasons longer and costs more.
# DEEPSEEK_MODEL=deepseek-v4-flash
# Covers reasoning AND the answer. Default: 8000.
# DEEPSEEK_MAX_TOKENS=8000
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Replicate (video shots: wan-video/wan-2.2-*) ---------------------------

REPLICATE_API_TOKEN=
# Shared secret Replicate signs its webhooks with. Get it once from
# https://api.replicate.com/v1/webhooks/default/secret — incoming webhooks are
# rejected unless the signature verifies.
REPLICATE_WEBHOOK_SECRET=

# --- ElevenLabs (voice-over) ------------------------------------------------
# The voice-over is not a garnish: it runs BEFORE the expensive visuals and
# before any payment, because the real length of the audio is what a scene
# lasts and therefore what the customer is charged. Without this key a video
# cannot be validated at all — its price would only ever be an estimate.
#
# The endpoint used is /text-to-speech/{voice}/with-timestamps, which returns
# the audio and a character-level alignment. That alignment is what gives the
# measured duration and the word-by-word karaoke subtitles.

ELEVENLABS_API_KEY=
# Fallback voice when neither the video nor the project names one. Accepts a
# short name (george, liam, antoni, anais, rachel) or a raw ElevenLabs id.
ELEVENLABS_DEFAULT_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1

# --- Cloudflare Workers AI (image shots: Flux) ------------------------------

CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- YouTube Data API (OAuth + publishing) ----------------------------------
# Redirect URI to register: ${BASE_URL}/api/youtube/callback
# Quota note: uploads cost 1600 units against a 10 000/day project-wide quota
# (~6 uploads/day for ALL tenants). Request an increase early.

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- n8n orchestrator -------------------------------------------------------
# n8n never touches Postgres directly: it calls signed internal API routes.
# This shared secret authenticates both directions.
#   openssl rand -hex 32
N8N_WEBHOOK_SECRET=
# Base URL of the n8n instance the app calls to start a workflow.
N8N_BASE_URL=

# --- GeniusPay (subscriptions + top-ups, XOF) -------------------------------
# The platform bills tenants through ONE merchant account, so these keys are the
# whole payment configuration: there is no per-tenant credentials table and no
# admin screen for prices (the catalogue is code, in lib/billing/plans.ts).
#
# Webhook to declare on the GeniusPay dashboard:
#   ${BASE_URL}/api/webhooks/geniuspay

# Which key set below is active. Anything other than exactly `live` is sandbox —
# going to production is an explicit act, never a typo.
GENIUS_ENV=sandbox

# Merchant API base URL. Same host for both environments: the KEY is what
# decides which one is real, which is why a live key sitting under a
# GENIUS_SANDBOX_* name throws instead of quietly charging real money.
GENIUS_URL_ENDPOINT=https://geniuspay.ci/api/v1/merchant

# --- Sandbox key set --------------------------------------------------------
# The three are required TOGETHER. Without the webhook secret a checkout still
# succeeds and the customer still pays, but the confirmation can never be
# verified and no balance is ever credited — so billing refuses to start at all.

# Public key, sent as `X-API-Key`.
GENIUS_SANDBOX_API_KEY=
# Secret key, sent as `X-API-Secret`. Never leaves the server.
GENIUS_SANDBOX_SECRET_KEY=
# HMAC key the gateway signs its callbacks with. A badly signed callback is
# answered 401 and nothing is written.
GENIUS_SANDBOX_WEBHOOK_SECRET=

# --- Live key set -----------------------------------------------------------
# Fill these in and flip GENIUS_ENV=live. The sandbox keys stay where they are:
# both sets coexist, so no deploy ever has to rename a variable to go live.

GENIUS_LIVE_API_KEY=
GENIUS_LIVE_SECRET_KEY=
GENIUS_LIVE_WEBHOOK_SECRET=
